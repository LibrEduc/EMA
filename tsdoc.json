      "tagName": "@author",
      "syntaxKind": "block"
    },
    {
      "tagName": "@license",
      "syntaxKind": "block"
    },
    {
      "tagName": "@fileoverview",
      "syntaxKind": "block"
    },
    {
      "tagName": "@return",
      "syntaxKind": "block"
    },
    {
