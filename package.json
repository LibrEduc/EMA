{
  "name": "µcBlockly",
  "version": "2.2.0",
  "description": "Program microcontrollers thanks to Blockly",
  "main": "build/src/core/index.js",
  "module": "build/src/core/index.js",
  "types": "build/src/core/index.d.ts",
  "private": true,
  "type": "module",
  "scripts": {
    "audit": "npm audit fix",
    "build:lib": "tsc -p tsconfig.json",
    "build:core": "tsc -p tsconfig.core.json",
    "build:core:bundle": "npm run build:core && webpack --config webpack.core.config.mjs --mode production",
    "build:demo": "npm run build:lib && webpack --mode production",
    "build": "npm run build:demo && npm run build:core && npm run build:core:bundle",
    "build:local": "webpack --config webpack.local.config.mjs",
    "build:prod-hardened": "cross-env UCB_HARDENED=1 webpack --mode production",
    "docs": "typedoc",
    "lint": "eslint src --fix --ignore-pattern src/out/**",
    "check-translations": "node scripts/check-translations.cjs",
    "convert-rduino": "node scripts/convert-rduino-workspace.mjs",
    "generate-favicon": "node scripts/generate-favicon.mjs",
    "extract-functions": "node scripts/extract-functions.js",
    "test": "tsx --test tests/**/*.test.ts",
    "dev": "webpack serve --open --mode development",
    "dev:embed": "webpack serve --config webpack.core.config.mjs --open --mode development"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/A-S-T-U-C-E/ucBlockly.git"
  },
  "author": "Sébastien Canet",
  "license": "GNU GENERAL PUBLIC LICENSE Version 3 (GPLv3)",
  "bugs": {
    "url": "https://github.com/A-S-T-U-C-E/ucBlockly/issues"
  },
  "keywords": [
    "blockly",
    "microcontrollers"
  ],
  "files": [
    "build",
    "dist/core",
    "docs/KERNEL.md",
    "LICENSE",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./build/src/core/index.d.ts",
      "import": "./build/src/core/index.js"
    },
    "./core": {
      "types": "./build/src/core/index.d.ts",
      "import": "./build/src/core/index.js"
    },
    "./demo": {
      "types": "./build/src/index.d.ts",
      "import": "./build/src/index.js"
    }
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "~8.65.0",
    "@typescript-eslint/parser": "~8.65.0",
    "@xmldom/xmldom": "^0.9.10",
    "copy-webpack-plugin": "^14.0.0",
    "cross-env": "^10.1.0",
    "css-loader": "^7.1.4",
    "eslint": "~10.8.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-tsdoc": "^0.5.2",
    "html-webpack-plugin": "^5.6.8",
    "javascript-obfuscator": "^5.5.0",
    "jsdom": "^27.4.0",
    "sharp": "^0.35.3",
    "source-map-loader": "^5.0.0",
    "style-loader": "^4.0.0",
    "terser-webpack-plugin": "^5.6.1",
    "to-ico": "^1.1.5",
    "ts-loader": "^9.6.2",
    "tsx": "^4.23.1",
    "typedoc": "^0.28.20",
    "typescript": "~6.0.3",
    "webpack": "^5.109.0",
    "webpack-cli": "^7.2.1",
    "webpack-dev-server": "^6.0.0",
    "webpack-obfuscator": "^3.6.1"
  },
  "dependencies": {
    "@blockly/block-plus-minus": "^13.1.0",
    "@blockly/block-shareable-procedures": "^13.1.0",
    "@blockly/continuous-toolbox": "^13.1.0",
    "@blockly/field-angle": "^13.1.0",
    "@blockly/field-bitmap": "^6.0.9",
    "@blockly/field-colour": "^13.1.0",
    "@blockly/field-colour-hsv-sliders": "^6.0.12",
    "@blockly/field-date": "^13.1.0",
    "@blockly/field-dependent-dropdown": "^13.1.0",
    "@blockly/field-grid-dropdown": "^13.1.0",
    "@blockly/field-multilineinput": "^13.1.0",
    "@blockly/field-slider": "^13.1.0",
    "@blockly/plugin-modal": "^13.1.0",
    "@blockly/plugin-workspace-search": "^13.1.0",
    "@blockly/shadow-block-converter": "^13.1.0",
    "@blockly/theme-dark": "^13.1.0",
    "@blockly/theme-deuteranopia": "^13.1.0",
    "@blockly/theme-highcontrast": "^13.1.0",
    "@blockly/theme-modern": "^13.1.0",
    "@blockly/theme-tritanopia": "^13.1.0",
    "@blockly/toolbox-search": "^13.1.0",
    "@blockly/workspace-backpack": "^13.1.0",
    "@blockly/workspace-content-highlight": "^13.1.0",
    "@blockly/workspace-minimap": "^13.1.0",
    "@blockly/zoom-to-fit": "^13.1.0",
    "@eslint/eslintrc": "^3.3.6",
    "@eslint/js": "10.0.1",
    "@jaames/iro": "^5.5.2",
    "@microsoft/api-extractor": "^7.58.12",
    "blockly": "^13.1.1",
    "monaco-editor": "^0.56.0",
    "monaco-editor-webpack-plugin": "^7.1.1"
  },
  "overrides": {
    "typescript": "$typescript",
    "blockly": "$blockly",
    "@blockly/field-colour-hsv-sliders": {
      "blockly": "$blockly"
    },
    "@blockly/field-bitmap": {
      "blockly": "$blockly"
    }
  },
  "allowScripts": {
    "esbuild@0.28.1": true
  }
}
