{
  "name": "µcBlockly",
  "version": "2.1.1",
  "description": "Program microcontrollers thanks to Blockly",
  "main": "build/src/index.js",
  "module": "build/src/index.js",
  "types": "build/src/index.d.ts",
  "private": true,
  "type": "module",
  "scripts": {
    "audit": "npm audit fix",
    "build:lib": "tsc -p tsconfig.json",
    "build": "npm run build:lib && webpack --mode production",
    "build:local": "webpack --config webpack.local.config.mjs",
    "build:prod-hardened": "cross-env UCB_HARDENED=1 webpack --mode production",
    "docs": "typedoc",
    "docs:functions": "node scripts/extract-functions.js",
    "lint": "eslint src --fix --ignore-pattern src/out/**",
    "dev": "webpack serve --open --mode development",
    "update": "npm update"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/A-S-T-U-C-E/ucBlockly.git"
  },
  "author": "Sébastien Canet",
  "license": "GNU GENERAL PUBLIC LICENSE Version 3 (GPLv3)",
  "bugs": {
    "url": "https://github.com/A-S-T-U-C-E/ucBlockly/issues"
  },
  "keywords": [
    "blockly",
    "microcontrollers"
  ],
  "files": [
    "build",
    "dist/bundle",
    "LICENSE",
    "README.md"
  ],
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "~8.57.0",
    "@typescript-eslint/parser": "~8.57.0",
    "copy-webpack-plugin": "^14.0.0",
    "cross-env": "^10.1.0",
    "css-loader": "^7.1.4",
    "eslint": "~10.0.3",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.5",
    "eslint-plugin-tsdoc": "^0.5.2",
    "html-webpack-plugin": "^5.6.6",
    "javascript-obfuscator": "^5.3.0",
    "source-map-loader": "^5.0.0",
    "style-loader": "^4.0.0",
    "terser-webpack-plugin": "^5.4.0",
    "ts-loader": "^9.5.4",
    "typedoc": "^0.28.17",
    "typescript": "^5.9.3",
    "webpack": "^5.105.4",
    "webpack-cli": "^7.0.0",
    "webpack-dev-server": "^5.2.3",
    "webpack-obfuscator": "^3.6.0"
  },
  "dependencies": {
    "@blockly/block-plus-minus": "^9.0.9",
    "@blockly/block-shareable-procedures": "^6.0.10",
    "@blockly/continuous-toolbox": "^7.0.8",
    "@blockly/field-angle": "^6.0.8",
    "@blockly/field-colour": "^6.0.11",
    "@blockly/field-colour-hsv-sliders": "^6.0.11",
    "@blockly/field-date": "^10.0.8",
    "@blockly/field-multilineinput": "^6.0.8",
    "@blockly/field-slider": "^8.0.8",
    "@blockly/plugin-modal": "^8.0.8",
    "@blockly/plugin-workspace-search": "^10.1.7",
    "@blockly/shadow-block-converter": "^7.0.9",
    "@blockly/theme-dark": "^8.0.3",
    "@blockly/theme-deuteranopia": "^7.0.3",
    "@blockly/theme-highcontrast": "^7.0.3",
    "@blockly/theme-modern": "^7.0.4",
    "@blockly/theme-tritanopia": "^7.0.3",
    "@blockly/toolbox-search": "^3.1.8",
    "@blockly/workspace-backpack": "^7.0.9",
    "@blockly/workspace-content-highlight": "^6.0.8",
    "@blockly/workspace-minimap": "^0.3.8",
    "@blockly/zoom-to-fit": "^7.0.8",
    "@eslint/eslintrc": "^3.3.5",
    "@eslint/js": "10.0.1",
    "@jaames/iro": "^5.5.2",
    "@microsoft/api-extractor": "^7.57.7",
    "blockly": "^12.4.1",
    "monaco-editor": "^0.55.1",
    "monaco-editor-webpack-plugin": "^7.1.1"
  }
