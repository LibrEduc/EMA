{
  "name": "ema",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Coquille EMA autour de µcBlockly (Zelos + toolbox continue)",
  "scripts": {
    "prepare": "husky",
    "sync": "npm install --prefix vendor/ucBlockly",
    "media": "node scripts/copy-media.mjs",
    "postinstall": "npm run sync && npm run media",
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "electron:build": "vite build --base=./ --outDir dist-electron",
    "electron:start": "electron electron/main.mjs",
    "electron:run": "npm run electron:build && npm run electron:start",
    "test:electron": "npm run electron:build && electron tests/electron-smoke.cjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run && node --test tests/electron-menu.test.mjs",
    "test:electron-menu": "node --test tests/electron-menu.test.mjs"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "dependencies": {
    "@blockly/block-plus-minus": "^13.4.0",
    "@blockly/continuous-toolbox": "^13.4.0",
    "@blockly/field-angle": "^13.4.0",
    "@blockly/field-bitmap": "^13.4.0",
    "@blockly/field-colour": "^13.4.0",
    "@blockly/field-colour-hsv-sliders": "^13.4.0",
    "@blockly/field-date": "^13.4.0",
    "@blockly/field-dependent-dropdown": "^13.4.0",
    "@blockly/field-grid-dropdown": "^13.4.0",
    "@blockly/field-multilineinput": "^13.4.0",
    "@blockly/field-slider": "^13.4.0",
    "@blockly/plugin-cross-tab-copy-paste": "^13.4.0",
    "@blockly/plugin-modal": "^13.4.0",
    "@blockly/plugin-workspace-search": "^13.4.0",
    "@blockly/shadow-block-converter": "^13.4.0",
    "@blockly/theme-dark": "^13.4.0",
    "@blockly/theme-deuteranopia": "^13.4.0",
    "@blockly/theme-highcontrast": "^13.4.0",
    "@blockly/theme-modern": "^13.4.0",
    "@blockly/theme-tritanopia": "^13.4.0",
    "@blockly/toolbox-search": "^13.4.0",
    "@blockly/workspace-backpack": "^13.4.0",
    "@blockly/workspace-content-highlight": "^13.4.0",
    "@blockly/workspace-minimap": "^13.4.0",
    "@blockly/zoom-to-fit": "^13.4.0",
    "@jaames/iro": "^5.5.2",
    "blockly": "^13.4.0"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "electron": "^45.3.4",
    "husky": "^9.1.7",
    "typescript": "~5.9.3",
    "vite": "^7.3.8",
    "vitest": "^4.1.12"
  }
}
