{
  "name": "EMA",
  "version": "3.0.0",
  "description": "Program microcontrollers thanks to Blockly",
  "homepage": "https://a-s-t-u-c-e.github.io/EMA/",
  "main": "build/src/core/index.js",
  "module": "build/src/core/index.js",
  "types": "build/src/core/index.d.ts",
  "private": true,
  "engines": {
    "node": ">=22.12.0"
  },
  "type": "module",
  "scripts": {
    "prepare": "husky",
    "audit": "npm audit",
    "build:lib": "tsc -p tsconfig.json",
    "build:core": "tsc -p tsconfig.core.json",
    "build:core:bundle": "npm run build:core && webpack --config webpack.core.config.mjs --mode production",
    "build:demo": "npm run build:lib && webpack --mode production",
    "build:pages": "npm run build:lib && cross-env UCB_PUBLIC_PATH=./ webpack --mode production",
    "build": "npm run build:demo && npm run build:core && npm run build:core:bundle",
    "build:local": "webpack --config webpack.local.config.mjs",
    "electron:build": "npm run build:local",
    "electron:start": "electron electron/main.mjs",
    "electron:run": "npm run electron:build && npm run electron:start",
    "build:prod-hardened": "cross-env UCB_HARDENED=1 webpack --mode production",
    "docs": "typedoc",
    "lint": "eslint src --fix",
    "lint:check": "eslint src",
    "check-translations": "node scripts/check-translations.cjs",
    "convert-rduino": "node scripts/convert-rduino-workspace.mjs",
    "generate-favicon": "node scripts/generate-favicon.mjs",
    "extract-functions": "node scripts/extract-functions.js",
    "build:extensions": "node scripts/build-extensions.mjs",
    "test": "tsx --test tests/**/*.test.ts",
    "dev": "webpack serve --open --mode development",
    "dev:embed": "webpack serve --config webpack.core.config.mjs --open --mode development"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/A-S-T-U-C-E/ucBlockly.git"
  },
  "author": "Sébastien Canet",
  "license": "AGPL-3.0-or-later",
  "bugs": {
    "url": "https://github.com/A-S-T-U-C-E/ucBlockly/issues"
  },
  "keywords": [
    "blockly",
    "microcontrollers"
  ],
  "files": [
    "build",
    "dist/core",
    "docs/KERNEL.md",
    "LICENSE",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./build/src/core/index.d.ts",
      "import": "./build/src/core/index.js"
    },
    "./core": {
      "types": "./build/src/core/index.d.ts",
      "import": "./build/src/core/index.js"
    },
    "./host": {
      "types": "./build/src/host/index.d.ts",
      "import": "./build/src/host/index.js"
    },
    "./demo": {
      "types": "./build/src/index.d.ts",
      "import": "./build/src/index.js"
    }
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@eslint/eslintrc": "^3.3.7",
    "@eslint/js": "10.0.1",
    "@types/node": "^26.6.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@typescript-eslint/eslint-plugin": "~8.71.0",
    "@typescript-eslint/parser": "~8.71.0",
    "@xmldom/xmldom": "^0.9.12",
    "ajv": "^8.20.0",
    "copy-webpack-plugin": "^14.0.0",
    "cross-env": "^10.1.0",
    "css-loader": "^7.1.5",
    "electron": "^45.2.3",
    "eslint": "~10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-tsdoc": "^0.5.3",
    "html-webpack-plugin": "^5.6.8",
    "husky": "^9.1.7",
    "javascript-obfuscator": "^5.8.0",
    "jsdom": "^27.4.0",
    "monaco-editor-webpack-plugin": "^7.1.1",
    "sharp": "^0.35.5",
    "source-map-loader": "^5.0.0",
    "style-loader": "^4.0.0",
    "terser-webpack-plugin": "^5.6.1",
    "ts-loader": "^9.6.2",
    "tsx": "^4.23.15",
    "typedoc": "^0.28.20",
    "typescript": "~6.0.3",
    "webpack": "^5.111.1",
    "webpack-cli": "^7.2.3",
    "webpack-dev-server": "^6.0.0",
    "webpack-obfuscator": "^3.6.1"
  },
  "dependencies": {
    "@blockly/block-plus-minus": "^13.3.0",
    "@blockly/continuous-toolbox": "^13.3.0",
    "@blockly/field-angle": "^13.3.0",
    "@blockly/field-bitmap": "^13.3.0",
    "@blockly/field-colour": "^13.3.0",
    "@blockly/field-colour-hsv-sliders": "^13.3.0",
    "@blockly/field-date": "^13.3.0",
    "@blockly/field-dependent-dropdown": "^13.3.0",
    "@blockly/field-grid-dropdown": "^13.3.0",
    "@blockly/field-multilineinput": "^13.3.0",
    "@blockly/field-slider": "^13.3.0",
    "@blockly/plugin-cross-tab-copy-paste": "^13.3.0",
    "@blockly/plugin-modal": "^13.3.0",
    "@blockly/plugin-workspace-search": "^13.3.0",
    "@blockly/shadow-block-converter": "^13.3.0",
    "@blockly/theme-dark": "^13.3.0",
    "@blockly/theme-deuteranopia": "^13.3.0",
    "@blockly/theme-highcontrast": "^13.3.0",
    "@blockly/theme-modern": "^13.3.0",
    "@blockly/theme-tritanopia": "^13.3.0",
    "@blockly/toolbox-search": "^13.3.0",
    "@blockly/workspace-backpack": "^13.3.0",
    "@blockly/workspace-content-highlight": "^13.3.0",
    "@blockly/workspace-minimap": "^13.3.0",
    "@blockly/zoom-to-fit": "^13.3.0",
    "@jaames/iro": "^5.5.2",
    "blockly": "^13.3.0",
    "monaco-editor": "^0.57.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "overrides": {
    "typescript": "$typescript",
    "blockly": "$blockly",
    "@blockly/field-colour-hsv-sliders": {
      "blockly": "$blockly"
    },
    "@blockly/field-bitmap": {
      "blockly": "$blockly"
    },
    "dompurify": "^3.4.12",
    "brace-expansion": "5.0.9",
    "jsdom": "$jsdom"
  },
  "allowScripts": {
    "esbuild@0.28.1": true
  }
}
