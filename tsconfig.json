{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "strict": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "paths": {
      "µcBlockly/core": ["./vendor/ucBlockly/src/core/index.ts"],
      "blockly": ["./node_modules/blockly"],
      "blockly/*": ["./node_modules/blockly/*"]
    }
  },
  "include": ["src", "vendor/ucBlockly/src/types.d.ts"]
}
