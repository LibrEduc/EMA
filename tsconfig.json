{
  "compilerOptions": {
    "rootDir": "./src",
    "declaration": true,
    "declarationMap": true,
    "module": "ES2020",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "outDir": "build",
    "strict": true,
    "target": "ES2015",
    "types": [
      "node"
    ]
  },
  "include": ["src/**/*"],
  "exclude": ["tests/**/*", "build/**/*", "node_modules/**/*"]
}